# MineralForge blast vibration risk predictor configuration

# Optional LLM key for real CrewAI agent instantiation.
# Without a key, the CrewAI workflow uses deterministic agent specifications.
OPENAI_API_KEY=

# Default artifact and data locations.
MINERALFORGE_DATA_PATH=data/ground_vibration_dataset.csv
MINERALFORGE_MODEL_PATH=artifacts/vibration_detection_pipeline.joblib
